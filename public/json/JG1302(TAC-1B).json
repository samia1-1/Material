    {
      "name": "1.9、品种规格与供应状态",
      "con": "",
      "two": [
        {
          "name": "1.9.1、品种规格与供应状态",
          "con": "无"
        },
        {
          "name": "1.9.2、主要规格",
          "con": "d10mm～300mm棒材；δ2mm～20mm热轧板；δ0.3mm～4.0mm冷轧薄板；δ0.05mm～0.2mm箔板；各种规格的饼材和环形件。"
        },
        {
          "name": "1.9.3、供应状态",
          "con": "棒材、饼材和环形件经标准热处理或退火处理后，直接或经表面机加后供应；热轧板经标准热处理或退火处理十喷砂+矫正+切边后供应；冷轧板和箔材以冷轧或退火处理+切边后供应。"
        }
      ]
    }
