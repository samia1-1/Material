          "name": "1.9.1、品种规格与供应状态",
          "con": "摘自Q/3B 1063、QJ/DT 0160006和Q/GYB 05003。"
        },
        {
          "name": "1.9.2、主要规格",
          "con": "d10mm～180mm热轧及锻制棒材；δ0.8mm～1.5mm冷轧薄板。"
        },
        {
          "name": "1.9.3、供应状态",
          "con": "棒材以轧态或锻态供应；冷轧板材经固溶+酸碱洗+平整+矫直+切边后供应。"
        }
      ]
