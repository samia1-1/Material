          "con": ""
        },
        {
          "name": "1.5.2、Q/GYB544 JG1301 合金热轧和锻制棒材",
          "con": ""
        }
      ]
    },
    {
      "name": "1.6、熔炼工艺",
      "con": "采用真空自耗电弧炉多重熔炼工艺。"
